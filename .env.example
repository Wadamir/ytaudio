# Telegram
BOT_TOKEN=your_telegram_bot_token
BOT_USERNAME=@your_bot_username
ADMIN_USER_ID=123456789
MODER_USER_ID=123456789

# App
APP_ENV=dev
APP_DEBUG=false
BASE_URL=http://localhost:8080

# Database
DB_PATH=storage/db/bot.sqlite3
RESET_DB_ON_START=false

# Downloads
AUDIO_DIR=/storage/audio
YTDLP_JS_RUNTIME_PATH=/usr/bin/node
YTDLP_RETRIES=3
YTDLP_COOKIES_PATH=/storage/auth/cookies.txt

# Manual YouTube browser authorization
YOUTUBE_AUTH_URL=http://youtube-auth:8081
YOUTUBE_AUTH_NOVNC_URL=http://localhost:6080/vnc.html

# Routing
# proxy_only: use proxy routes only
# direct_proxy: try direct first, then proxies
YT_ROUTING_MODE=direct_proxy
# HTTP CONNECT proxies use http://; SOCKS5 proxies should use socks5h://.
# YouTube browser auth follows YT_PROXY_TYPE and falls back to the other type.
HTTP_PROXY_PRIMARY=
HTTP_PROXY_SECONDARY=
SOCKS_PROXY_PRIMARY=socks5h://ytaudio_net:1080
SOCKS_PROXY_SECONDARY=socks5h://ytaudio_net:1081
TG_PROXY_TYPE=http
YT_PROXY_TYPE=socks5
YT_IP_403_THRESHOLD=2
YT_IP_403_COOLDOWN_MIN=600
YT_IP_403_COOLDOWN_MAX=1200